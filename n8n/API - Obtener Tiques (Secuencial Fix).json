    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst body = $('Webhook (Power Automate)').first().json.body;\n\n// Opción para reiniciar el contador si el webhook lo pide\nif (body && body.reset_id === true) {\n    staticData.currentId = body.start_from ? parseInt(body.start_from) - 1 : 0;\n}\n\nif (staticData.currentId === undefined) {\n    staticData.currentId = 1;\n} else {\n    staticData.currentId += 1;\n}\n\n// Formateamos con 3 ceros a la izquierda: TK-001, TK-002, etc.\nconst paddedId = String(staticData.currentId).padStart(3, '0');\nconst ticketId = `TK-${paddedId}`;\n\nreturn {\n    generated_ticket_id: ticketId,\n    sequential_number: staticData.currentId,\n    original_body: body\n};"
      },
