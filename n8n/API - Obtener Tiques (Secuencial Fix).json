      "parameters": {
        "jsCode": "// Extraer el ID del tique del asunto\nconst subject = $('Webhook (Power Automate)').first().json.body.asunto || \"\";\n\n// Busca \"TK-\" seguido de cualquier cantidad de números (ej: TK-001, TK-45, etc.)\nconst match = subject.match(/TK-\\d+/i);\n\nlet extractedId = null;\nif (match) {\n  extractedId = match[0];\n}\n\nreturn {\n  extracted_ticket_id: extractedId,\n  original_body: $('Webhook (Power Automate)').first().json.body\n};"
      },
