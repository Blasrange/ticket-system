    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet maxId = 0;\n\n// Validamos que realmente haya datos\nif (items && items.length > 0) {\n  for (const item of items) {\n    // Validamos que el item tenga el campo user_id\n    if (item.json && item.json.user_id) {\n      const uid = item.json.user_id;\n      if (typeof uid === 'string' && uid.startsWith('U-')) {\n        const num = parseInt(uid.replace('U-', ''), 10);\n        if (!isNaN(num) && num > maxId) {\n          maxId = num;\n        }\n      }\n    }\n  }\n}\n\n// Formateamos con 3 ceros a la izquierda: U-001, U-002, etc.\nconst nextId = `U-${String(maxId + 1).padStart(3, '0')}`;\n\nreturn {\n  json: {\n    generated_user_id: nextId\n  }\n};"
      },
