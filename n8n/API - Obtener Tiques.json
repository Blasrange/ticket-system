      "parameters": {
        "jsCode": "// Extraer el ID del tique del asunto\nconst subject = $('Webhook (Power Automate)').first().json.body.asunto || \"\";\n\n// Esta expresión regular busca el ID aunque no tenga corchetes\nconst match = subject.match(/TK-\\d{8}-\\d{1,3}/i);\n\nlet extractedId = null;\nif (match) {\n  // Como ya no incluimos los corchetes en la búsqueda, extraemos directo el ID\n  extractedId = match[0];\n}\n\nreturn {\n  extracted_ticket_id: extractedId,\n  original_body: $('Webhook (Power Automate)').first().json.body\n};"
      },
      "type": "n8n-nodes-base.code",
