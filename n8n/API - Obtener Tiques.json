      "parameters": {
        "jsCode": "// Obtenemos los datos estáticos globales del workflow para mantener el contador persistente\nconst staticData = $getWorkflowStaticData('global');\n\n// Obtenemos el body del webhook de Power Automate\nconst body = $('Webhook (Power Automate)').first().json.body;\n\n// Opción para reiniciar: Si el webhook trae una propiedad para reiniciar (ej. reset_id: true), \n// podemos reiniciar el contador al valor que desees (por defecto a 0, o el que envíes en 'start_from')\nif (body && body.reset_id === true) {\n    staticData.currentId = body.start_from ? parseInt(body.start_from) - 1 : 0;\n}\n\n// Si el contador no existe, lo inicializamos en 0, de lo contrario le sumamos 1\nif (staticData.currentId === undefined) {\n    staticData.currentId = 1;\n} else {\n    staticData.currentId += 1;\n}\n\n// Formateamos el ID con ceros a la izquierda (ej: TK-0001, TK-0002) o como prefieras\nconst paddedId = String(staticData.currentId).padStart(4, '0');\nconst ticketId = `TK-${paddedId}`;\n\nreturn {\n    generated_ticket_id: ticketId,\n    sequential_number: staticData.currentId,\n    original_body: body\n};"
      },
